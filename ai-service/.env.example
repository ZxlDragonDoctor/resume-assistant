# ============================================================
#  AI Service 配置
#  复制为 .env 后填写。不配置 API Key 也能跑 —— 会自动降级为
#  本地规则引擎（要点润色 / ATS 评分 / JD 解析 / 面试题均可用）。
# ============================================================

# 通义千问（当前默认，DashScope OpenAI 兼容模式，国内可直连）
# API Key 申请：https://bailian.console.aliyun.com/  → API-KEY 管理
OPENAI_API_KEY=sk-your-dashscope-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max

# 可选模型（同一 Key 通用，按质量/成本从高到低）：
#   qwen3-max    最新旗舰，质量最好
#   qwen-max     旗舰稳定版（默认）
#   qwen-plus    均衡，性价比高
#   qwen-turbo   最快最便宜

# 或者使用 DeepSeek（OpenAI 兼容协议）
# OPENAI_API_KEY=sk-your-deepseek-api-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 或者使用 OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.6
LLM_TIMEOUT=60

REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

PORT=8086
