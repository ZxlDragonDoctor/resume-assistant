# 复制为 .env 后按需修改。.env 已被 gitignore，切勿提交。
# docker-compose 会自动读取同目录下的 .env。

# ---------- 安全（生产必改） ----------
# JWT 签名密钥，gateway 与 auth-service 必须一致。
# 生成：openssl rand -base64 48
JWT_SECRET=local-dev-jwt-secret-change-me-before-deploy-0123456789

# 数据库
DB_USERNAME=resume
DB_PASSWORD=resume123

# MinIO 对象存储
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PUBLIC_ENDPOINT=http://localhost:9010

# RabbitMQ
RABBITMQ_USER=resume
RABBITMQ_PASSWORD=resume123

# ---------- AI（不填则走本地规则引擎） ----------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-max

# ---------- 可选覆盖 ----------
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# AI_SERVICE_URL=http://localhost:8086
# EXPORT_SERVICE_URL=http://localhost:8085
